// Hack memory map: RAM16K, Screen, Keyboard.
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    Not(in=address[14], out=ramSel);
    And(a=address[14], b=address[13], out=kbdSel);
    Not(in=address[13], out=notA13);
    And(a=address[14], b=notA13, out=screenSel);

    And(a=load, b=ramSel, out=loadRAM);
    And(a=load, b=screenSel, out=loadScreen);
    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);
    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=kbdOut,
              sel=address[13..14], out=out);
}
